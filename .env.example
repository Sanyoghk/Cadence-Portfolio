# Production database configuration. Copy to a local .env file only when needed;
# never commit real credentials.
CADENCE_DB_URL=jdbc:postgresql://localhost:5432/cadence
CADENCE_DB_USERNAME=cadence
CADENCE_DB_PASSWORD=replace-me
CADENCE_DB_MAX_POOL_SIZE=10
CADENCE_DB_MIN_IDLE=2

# Account admission includes archived workspaces; allowed range 1..10, default 3.
CADENCE_MAX_WORKSPACES_PER_ACCOUNT=3

# Enable only after reviewing docs/adr/0005-pinned-url-evidence-fetching.md.
# Production providers require explicit s3+clamd profiles and operational acknowledgements.
CADENCE_URL_FETCH_WORKER_ENABLED=false

# See docs/clamd-scanning.md and docs/quarantine-lifecycle.md.
CADENCE_FILE_SCAN_WORKER_ENABLED=false
CADENCE_EVIDENCE_CLEANUP_ENABLED=false
CADENCE_EVIDENCE_ARTIFACTS_ENABLED=false
CADENCE_EVIDENCE_PRODUCTION_APPROVED=false
CADENCE_EVIDENCE_EGRESS_POLICY_ACKNOWLEDGED=false
CADENCE_EVIDENCE_RETENTION_POLICY_ACKNOWLEDGED=false

# S3-compatible provider; production requires TLS and a pre-provisioned private bucket.
CADENCE_EVIDENCE_S3_ENDPOINT=https://s3.example.com
CADENCE_EVIDENCE_S3_REGION=us-east-1
CADENCE_EVIDENCE_S3_BUCKET=private-evidence
CADENCE_EVIDENCE_S3_ACCESS_KEY=replace-me
CADENCE_EVIDENCE_S3_SECRET_KEY=replace-me
CADENCE_EVIDENCE_S3_ALLOW_INSECURE_LOCAL=false
CADENCE_EVIDENCE_S3_MINIO_FIXTURE=false
CADENCE_EVIDENCE_S3_OPERATION_TIMEOUT=PT15S
CADENCE_EVIDENCE_S3_CONNECT_TIMEOUT=PT3S
CADENCE_EVIDENCE_S3_MAX_CONCURRENT_OPERATIONS=8
CADENCE_EVIDENCE_CLAMD_HOST=clamd.internal
CADENCE_EVIDENCE_CLAMD_ALLOWED_CIDRS=10.117.0.0/24
CADENCE_EVIDENCE_CLAMD_PRIVATE_CHANNEL_ACKNOWLEDGED=false
CADENCE_EVIDENCE_CLAMD_SIGNATURE_MAX_AGE=PT48H
CADENCE_EVIDENCE_CLAMD_DEADLINE=PT30S
CADENCE_EVIDENCE_CLAMD_MAX_CONCURRENT=2
CADENCE_EVIDENCE_RENDERER_HOST=renderer.internal
CADENCE_EVIDENCE_RENDERER_ALLOWED_CIDRS=10.117.0.0/24
CADENCE_EVIDENCE_RENDERER_TOKEN=replace-with-generated-private-token
CADENCE_EVIDENCE_RENDERER_PRIVATE_CHANNEL_ACKNOWLEDGED=false
CADENCE_EVIDENCE_RENDERER_DEADLINE=PT20S

# Shared per-workspace admission, storage and cost limits. Failed attempts retain their budgets.
CADENCE_EVIDENCE_MAX_CONCURRENT_UPLOADS=2
CADENCE_EVIDENCE_MAX_NON_MULTIPART_BYTES=131072
CADENCE_EVIDENCE_REGISTRATION_MAX_WORKSPACE_EVIDENCE=1000
CADENCE_EVIDENCE_REGISTRATION_MAX_WORKSPACE_REGISTRATIONS_PER_HOUR=100
CADENCE_EVIDENCE_LIFECYCLE_MAX_WORKSPACE_BYTES=536870912
CADENCE_EVIDENCE_LIFECYCLE_MAX_WORKSPACE_OBJECTS=1000
CADENCE_EVIDENCE_LIFECYCLE_MAX_WORKSPACE_WRITES_PER_HOUR=100
CADENCE_EVIDENCE_LIFECYCLE_WRITE_DEADLINE=PT2M
CADENCE_EVIDENCE_LIFECYCLE_ORPHAN_RETENTION=PT24H
CADENCE_EVIDENCE_LIFECYCLE_DELETION_DRAIN=PT5M
CADENCE_EVIDENCE_LIFECYCLE_TOMBSTONE_SWEEP=PT1H
CADENCE_EVIDENCE_LIFECYCLE_CLEANUP_BATCH=20
CADENCE_EVIDENCE_ARTIFACTS_MAX_SCAN_AGE=PT24H
CADENCE_EVIDENCE_SOCIAL_ENABLED=false
CADENCE_EVIDENCE_SOCIAL_DEADLINE=10s
CADENCE_EVIDENCE_SOCIAL_MAX_REQUESTS_PER_HOUR=100
CADENCE_EVIDENCE_SOCIAL_MAX_WORKSPACE_CALLS_PER_HOUR=100
CADENCE_EVIDENCE_SOCIAL_MAX_PROVIDER_CALLS_PER_HOUR=50

# Local Compose placeholders only. scripts/start_local_evidence.ps1 generates ignored values.
CADENCE_LOCAL_DB_PASSWORD=replace-with-generated-local-secret
CADENCE_LOCAL_RUNTIME_DB_PASSWORD=replace-with-generated-local-secret
CADENCE_LOCAL_MINIO_ADMIN=replace-with-local-admin-identity
CADENCE_LOCAL_MINIO_ADMIN_PASSWORD=replace-with-generated-local-secret
CADENCE_LOCAL_S3_ACCESS_KEY=replace-with-local-runtime-identity
CADENCE_LOCAL_S3_SECRET_KEY=replace-with-generated-local-secret
CADENCE_LOCAL_RENDERER_TOKEN=replace-with-generated-local-token
CADENCE_LOCAL_POSTGRES_PORT=15432
CADENCE_LOCAL_MINIO_PORT=19000
CADENCE_LOCAL_APP_PORT=18080

# Clerk values are available in the Clerk Dashboard. Keep role and workspace claims
# in server-controlled session-token metadata, never user-editable metadata.
CLERK_ISSUER_URI=https://your-instance.clerk.accounts.dev
# Explicit browser origins, without paths/trailing slash. Empty denies cross-origin access.
CADENCE_CORS_ALLOWED_ORIGINS=http://localhost:3000
CLERK_JWKS_URI=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=cadence-api
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://app.example.com

# Private CPU-only report worker; enable explicitly after migrations/runtime grants.
CADENCE_REPORTS_WORKER_ENABLED=false
