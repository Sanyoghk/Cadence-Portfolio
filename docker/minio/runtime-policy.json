{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketPolicy", "s3:GetBucketVersioning"], "Resource": ["arn:aws:s3:::cadence-evidence"]},
    {"Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"], "Resource": ["arn:aws:s3:::cadence-evidence/quarantine/*"]},
    {"Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"], "Resource": ["arn:aws:s3:::cadence-evidence/media/*"]}
  ]
}
