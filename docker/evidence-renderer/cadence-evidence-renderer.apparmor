# SPDX-License-Identifier: Apache-2.0
# Derived from Moby v28.0.4 profiles/apparmor/template.go (The Moby Authors):
# https://github.com/moby/moby/blob/v28.0.4/profiles/apparmor/template.go
# Apply only to the renderer container, never replace the host docker-default profile.
abi <abi/4.0>,
#include <tunables/global>

profile cadence-evidence-renderer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  unix,
  deny network alg,
  deny network vsock,
  capability,
  file,

  # Ubuntu 24.04 requires an explicit permission for unprivileged user namespaces.
  userns create,

  # The container has cap-drop ALL. These operations can succeed only after creating
  # its own user/mount/PID namespaces; no host CAP_SYS_ADMIN is granted.
  # Preserve inherited Docker proc masks: no fresh proc mount or unmount is permitted.
  # All other mounts are implicitly denied. Do not replace these with 'mount,'.
  mount options=(rw,rprivate) -> /,

  # Preserve Docker's host/runtime signal rules and same-profile child confinement.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=cadence-evidence-renderer,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=cadence-evidence-renderer,
}
