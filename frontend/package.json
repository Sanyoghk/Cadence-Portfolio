{
  "name": "@cadence/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "verify:export": "node scripts/verify-export.mjs",
    "contracts:generate": "node scripts/generate-identity-contract.mjs",
    "contracts:check": "node scripts/generate-identity-contract.mjs --check",
    "lint": "eslint . --max-warnings=0 && pnpm contracts:check && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "fixture": "vite --config tests/fixture/vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clerk/testing": "2.2.47",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
